flowchart LR
  Client["Clients<br/><b>1,000 TPS target</b>"]:::client
  DNS["Route 53 weighted records<br/><b>Oregon 100 · Ohio 0</b><br/>ARC-vended health checks"]:::control

  subgraph West["PRIMARY · us-west-2 (Oregon)"]
    direction TB
    WNLB["Network Load Balancer"]:::network
    WEKS["EKS Auto Mode<br/>HPA range 1–40"]:::compute
    WPods["<b>20 ready pods</b><br/>observed source maximum"]:::computeStrong
    WDDB["DynamoDB<br/>local replica"]:::data
    WNLB --> WPods
    WEKS --> WPods
    WPods --> WDDB
  end

  subgraph East["RECOVERY · us-east-2 (Ohio)"]
    direction TB
    ENLB["Network Load Balancer"]:::network
    EEKS["EKS Auto Mode<br/>HPA range 1–40"]:::compute
    EPods["<b>1 → 20 ready pods</b><br/>ARC pre-scales first"]:::computeStrong
    EDDB["DynamoDB<br/>local replica"]:::data
    ENLB --> EPods
    EEKS --> EPods
    EPods --> EDDB
  end

  subgraph Recovery["ARC CONTROL PLANE"]
    direction TB
    ARC["ARC Region Switch<br/><b>one active/passive plan</b>"]:::arc
    Gate["Custom Lambda gate<br/>97% availability policy<br/><b>skipped for ungraceful recovery</b>"]:::gate
    Scale["EKSResourceScaling<br/><b>sampledMaxInLast24Hours = 20</b><br/>targetPercent = 100"]:::arc
    Route["Route53HealthCheck<br/><b>Ohio healthy · Oregon unhealthy</b>"]:::arc
    ARC --> Scale --> Route
    Gate -. graceful only .-> ARC
  end

  CW["CloudWatch<br/>AvailabilityPercent"]:::telemetry

  Client --> DNS
  DNS -->|"before"| WNLB
  DNS -. "after ARC health-state switch" .-> ENLB
  CW -. optional signal .-> Gate
  Scale -->|"pre-scale before traffic"| EEKS
  Route -->|"change health states"| DNS
  WDDB <-->|"DynamoDB Global Tables replication"| EDDB

