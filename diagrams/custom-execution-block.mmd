flowchart LR
  Plan["Ohio activation workflow<br/><b>Start: Oregon active</b>"]:::arc
  Mode{"Execution mode"}:::decision

  subgraph Custom["1 · CUSTOM LAMBDA"]
    direction TB
    Graceful["<b>GRACEFUL<br/>PATH</b>"]:::label
    Invoke["Invoke Lambda in<br/><b>activating Region</b><br/>timeout 2 min · retry 30 sec"]:::lambda
    Read["Describe CloudWatch alarm<br/><b>AvailabilityPercent &lt; 97%</b>"]:::telemetry
    State{"Alarm state"}:::decision
    Alarm["ALARM<br/><b>raise error · stop</b>"]:::stop
    OK["OK<br/><b>continue</b>"]:::go
    Missing["MISSING DATA<br/>or API exception<br/><b>explicit fail-open</b>"]:::warn

    Ungraceful["<b>UNGRACEFUL<br/>PATH</b>"]:::label
    Skip["ARC behavior: <b>skip</b><br/>No Lambda or CloudWatch<br/>dependency in recovery path"]:::skip

    Graceful --> Invoke --> Read --> State
    State --> Alarm
    State --> OK
    State --> Missing
    Ungraceful --> Skip
  end

  Scale["BLOCK 2 · EKS RESOURCE SCALING<br/><b>sampledMaxInLast24Hours × 100%</b><br/>Ohio 1 → 20 ready pods"]:::eks
  Route["BLOCK 3 · ROUTE 53 HEALTH CHECK<br/><b>Ohio healthy · Oregon unhealthy</b><br/>traffic changes only after readiness"]:::route
  Validate["VALIDATE<br/>Ohio response · 20 ready pods<br/>local DynamoDB read"]:::go

  Plan --> Mode
  Mode --> Graceful
  Mode --> Ungraceful
  OK --> Scale
  Missing --> Scale
  Skip --> Scale
  Scale --> Route --> Validate

  Role["ARC execution role<br/>InvokeFunction · DescribeCluster<br/>Route 53 read"]:::iam
  Access["EKS access entry in each Region<br/>AmazonARCRegionSwitchScalingPolicy<br/>namespace: arc-lab"]:::iam
